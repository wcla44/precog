{
  description = "precog: gaze-aware desktop assistant (Linux/X11 build, dev shell and portable bundle)";

  # Without root, run every nix command through nix-user-chroot:
  #   nix-user-chroot ~/.nix bash -lc 'nix develop -c cargo build --release'   # dev build (incremental)
  #   nix-user-chroot ~/.nix bash -lc 'nix build --cores 3 .'                  # wrapped package -> ./result/bin/precog
  #   nix-user-chroot ~/.nix bash -lc 'nix bundle --cores 3 .'                 # single portable executable
  # The package and the bundle need the ONNX models in the store once (see `models` below).

  inputs = {
    nixpkgs.url = "github:NixOS/nixpkgs/nixos-unstable";
    rust-overlay = {
      url = "github:oxalica/rust-overlay";
      inputs.nixpkgs.follows = "nixpkgs";
    };
  };

  outputs = { self, nixpkgs, rust-overlay }:
    let
      system = "x86_64-linux";
      pkgs = import nixpkgs { inherit system; overlays = [ rust-overlay.overlays.default ]; };
      lib = pkgs.lib;

      toolchain = pkgs.rust-bin.fromRustupToolchainFile ./rust-toolchain.toml;
      rustPlatform = pkgs.makeRustPlatform { cargo = toolchain; rustc = toolchain; };

      # ort's own prebuilt ONNX Runtime (static, CPU only), pinned to the URL and sha256 that ort-sys 2.0.0-rc.14 uses
      # (build/download/dist.tsv). The nixpkgs onnxruntime is older (API 27 < 31) and pulls OpenVINO + Python (~330 MB).
      onnxruntime-static = pkgs.runCommand "onnxruntime-static-1.31.0" {
        src = pkgs.fetchurl {
          url = "https://cdn.pyke.io/0/pyke:ort-rs/ms@1.31.0/x86_64-unknown-linux-gnu.tar.lzma2";
          sha256 = "02aac0d3b4927026292088986d7a377c657c88761b1c068be217a67b35447678";
        };
        nativeBuildInputs = [ pkgs.python3 ];
      } ''
        # raw LZMA2 stream (no xz container), 64 MiB dictionary, as in ort-sys' extractor
        mkdir -p $out/lib
        python3 -c "import lzma,sys; sys.stdout.buffer.write(lzma.LZMADecompressor(format=lzma.FORMAT_RAW, filters=[{'id': lzma.FILTER_LZMA2, 'dict_size': 1 << 26}]).decompress(open(sys.argv[1], 'rb').read()))" $src \
          | tar -x -C $out/lib
      '';

      nativeBuildInputs = with pkgs; [ pkg-config cmake nasm perl rustPlatform.bindgenHook makeWrapper ];

      buildInputs = with pkgs; [
        gtk3 glib cairo pango gdk-pixbuf atk libayatana-appindicator
        alsa-lib pipewire dbus openssl
        libx11 libxcursor libxi libxrandr libxtst libxcb libxkbcommon
        wayland libGL libgbm libdrm mesa
      ];

      # Loaded with dlopen at runtime (winit, glutin, libappindicator), so not in the binary's RUNPATH.
      runtimeLibs = with pkgs; [
        libGL libglvnd mesa libx11 libxcursor libxi libxrandr libxcb libxkbcommon wayland
        libayatana-appindicator gtk3
      ];

      buildEnv = {
        # Link the pinned static onnxruntime instead of letting ort download it (no network in nix builds).
        ORT_LIB_LOCATION = "${onnxruntime-static}/lib";
        ORT_SKIP_DOWNLOAD = "1";
        # Portable whisper.cpp: the nix cc-wrapper strips -march=native anyway, so pin an
        # x86-64-v3 baseline (AVX2/FMA, every x86 CPU since ~2015) instead of falling back to SSE2.
        GGML_NATIVE = "OFF";
        GGML_AVX = "ON";
        GGML_AVX2 = "ON";
        GGML_FMA = "ON";
        GGML_F16C = "ON";
        GGML_BMI2 = "ON";
      };

      # OCR for halo captures (English + French only: all languages would add ~600 MB)
      tesseract = pkgs.tesseract.override { enableLanguages = [ "eng" "fra" ]; };

      # GL through nixpkgs' mesa, so it doesn't depend on the host's drivers (AMD/Intel; NVIDIA blob falls back to llvmpipe).
      runtimeEnv = {
        LD_LIBRARY_PATH = lib.makeLibraryPath runtimeLibs;
        # The host's ALSA config routes "default" to PulseAudio/PipeWire: nixpkgs' alsa-lib needs the plugins for it,
        # or the microphone fails with "Unknown PCM default".
        ALSA_PLUGIN_DIR = "${pkgs.alsa-plugins}/lib/alsa-lib";
        LIBGL_DRIVERS_PATH = "${pkgs.mesa}/lib/dri";
        __EGL_VENDOR_LIBRARY_FILENAMES = "${pkgs.mesa}/share/glvnd/egl_vendor.d/50_mesa.json";
      };

      # MediaPipe models converted to ONNX. They are gitignored (generated by scripts/convert_models.sh), so the flake
      # takes them as a fixed-hash store path. If the hash differs on your machine, update it here.
      models = (pkgs.requireFile {
        name = "precog-onnx-models";
        hashMode = "recursive";
        hash = "sha256-mEEs79+eRNjI6mWSlRZ/ESLvQwPNEQoN95u7155K/zM=";
        message = ''
          The ONNX models are not in the nix store. From the repo root:
            scripts/convert_models.sh
            nix store add-path models/onnx --name precog-onnx-models
        '';
      }).overrideAttrs { meta.license = lib.licenses.asl20; }; # MediaPipe models (requireFile defaults to unfree)

      precog = rustPlatform.buildRustPackage ({
        pname = "precog";
        version = "0.2.0";
        # Only what cargo needs, so editing the flake or docs doesn't rebuild the package.
        src = lib.fileset.toSource {
          root = ./.;
          fileset = lib.fileset.unions [ ./Cargo.toml ./Cargo.lock ./build.rs ./src ./.cargo ./rust-toolchain.toml ];
        };
        cargoLock.lockFile = ./Cargo.lock;
        inherit nativeBuildInputs buildInputs;
        doCheck = false; # tests run in the dev shell
        postInstall = ''
          wrapProgram $out/bin/precog \
            --prefix PATH : ${lib.makeBinPath [ pkgs.xdotool tesseract ]} \
            --prefix LD_LIBRARY_PATH : ${runtimeEnv.LD_LIBRARY_PATH} \
            --set-default LIBGL_DRIVERS_PATH ${runtimeEnv.LIBGL_DRIVERS_PATH} \
            --set-default ALSA_PLUGIN_DIR ${runtimeEnv.ALSA_PLUGIN_DIR} \
            --set-default __EGL_VENDOR_LIBRARY_FILENAMES ${runtimeEnv.__EGL_VENDOR_LIBRARY_FILENAMES} \
            --set-default PRECOG_MODELS ${models}
        '';
        meta.mainProgram = "precog";
      } // buildEnv);
    in {
      packages.${system} = {
        default = precog;
        inherit precog models;
      };

      devShells.${system}.default = pkgs.mkShell ({
        inherit buildInputs;
        nativeBuildInputs = nativeBuildInputs ++ [ toolchain pkgs.xdotool tesseract ];
        # Low memory laptop: few parallel rustc jobs, and cmake (whisper.cpp, aws-lc) follows suit.
        CARGO_BUILD_JOBS = "3";
        CMAKE_BUILD_PARALLEL_LEVEL = "2";
        shellHook = ''
          export LD_LIBRARY_PATH=${runtimeEnv.LD_LIBRARY_PATH}''${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}
          export LIBGL_DRIVERS_PATH=${runtimeEnv.LIBGL_DRIVERS_PATH}
          export ALSA_PLUGIN_DIR=${runtimeEnv.ALSA_PLUGIN_DIR}
          export __EGL_VENDOR_LIBRARY_FILENAMES=${runtimeEnv.__EGL_VENDOR_LIBRARY_FILENAMES}
        '';
      } // buildEnv);
    };
}
